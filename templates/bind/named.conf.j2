acl internal { {{ ip_subnet }}/24; };

options {
        directory "/var/named";
        version "not currently available";
        recursion yes;
        allow-query { internal; };
        empty-zones-enable yes;
        forwarders { {{ dns_forwarders|join('; ') }}; };
        forward only;
};

logging{
   channel simple_log {
        file "/var/log/bind/bind.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-severity yes;
        print-category yes;
   };
   channel debug_log {
        file "/var/log/bind/bind_debug.log" versions 3 size 5m;
        severity dynamic;
        print-time yes;
        print-severity yes;
        print-category yes;
   };
   category default{
       simple_log;
   };
};

zone "localhost" {
        type primary;
        file "localhost-forward.db";
        notify no;
};

zone "0.0.127.in-addr.arpa" {
        type primary;
        file "named.local";
        notify no;
};

zone "{{ ip_subnet_octets[1] }}.{{ ip_subnet_octets[0] }}.in-addr.arpa"  {
        type primary;
        file "{{ ip_subnet_octets[1] }}.{{ ip_subnet_octets[0] }}.in-addr.arpa";
        check-names ignore;
};

zone "{{ base_domain }}" {
        type primary;
        file "{{ base_domain }}";
        check-names ignore;
};
